# ==========================================
# CacheMind AI - Configuration & Environment
# ==========================================

# Port configuration (Defaults to 7860 for Hugging Face Spaces & Docker)
PORT=7860

# --- Vector Embedding Model (Runs locally via sentence-transformers, free) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Semantic Cache Engine Settings ---
SIMILARITY_THRESHOLD=0.88
CACHE_TTL_SECONDS=86400
MAX_CACHE_SIZE=1000
CACHE_INDEX_PATH=./data/faiss_index.bin
CACHE_DB_PATH=./data/cache_db.sqlite

# --- Security & Rate Limiting ---
# Optional API Key authentication (Leave blank to disable auth)
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# --- Upstream LLM Provider ---
# Options: "groq" (Free-tier hosted API), "ollama" (Local offline), "mock" (Internal mock responses)
LLM_PROVIDER=groq

# Groq API Configuration (Get your free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama API Configuration (For fully local execution)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# --- Dollar Cost Math Parameters ($ per 1M tokens) ---
COST_PER_1M_INPUT_TOKENS=0.15
COST_PER_1M_OUTPUT_TOKENS=0.60
