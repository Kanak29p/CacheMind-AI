# Copy this file to .env and fill in as needed.
# Everything below has a free-tier or zero-cost option.

# "groq" (free-tier hosted, real $ savings math) or "ollama" (fully local, zero cost)
LLM_PROVIDER=groq

# Only needed if LLM_PROVIDER=groq. Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Only needed if LLM_PROVIDER=ollama (make sure `ollama serve` is running)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Cache tuning
SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# Cost model for the dashboard's "$ saved" math ($ per 1M tokens)
COST_PER_1M_INPUT_TOKENS=0.15
COST_PER_1M_OUTPUT_TOKENS=0.60
